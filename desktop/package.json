{
  "name": "kirkahub-aim-trainer",
  "productName": "Kirka Hub Aim Trainer",
  "version": "1.2.2",
  "private": true,
  "description": "The Kirka Hub aim trainer as a desktop app, without the browser's frame rate cap.",
  "author": "Kirka Hub",
  "main": "main.cjs",
  "scripts": {
    "build:web": "cd .. && vite build --config desktop/vite.aim.config.mjs --mode desktop && node desktop/legacy-css.mjs",
    "start": "electron ."
  },
  "build": {
    "appId": "online.kirkahub.aimtrainer",
    "files": [
      "main.cjs",
      "app/**"
    ],
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "mac": {
      "category": "public.app-category.games",
      "icon": "build/icon.png",
      "identity": null,
      "hardenedRuntime": false
    }
  },
  "devDependencies": {
    "@csstools/postcss-cascade-layers": "^6.0.2",
    "@csstools/postcss-is-pseudo-class": "^6.0.3",
    "electron": "^11.5.0",
    "electron-builder": "^26.18.0",
    "lightningcss": "^1.33.0",
    "postcss": "^8.5.32"
  }
}
