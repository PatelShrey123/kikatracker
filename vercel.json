{
  "redirects": [
    { "source": "/((?!ad-frame\\.html).*)", "has": [{ "type": "host", "value": "ads.kirkahub.online" }], "destination": "https://kirkahub.online/$1", "permanent": true }
  ],
  "headers": [
    {
      "source": "/embed/:path*",
      "headers": [
        { "key": "Content-Security-Policy", "value": "frame-ancestors https://rite.lat https://www.rite.lat" },
        { "key": "Cache-Control", "value": "public, max-age=300, s-maxage=3600" }
      ]
    }
  ],
  "rewrites": [
    { "source": "/embed/profile", "destination": "/embed/profile.html" },
    { "source": "/embed/profile/:id", "destination": "/embed/profile.html" },
    { "source": "/embed/inventory", "destination": "/embed/inventory.html" },
    { "source": "/embed/inventory/:id", "destination": "/embed/inventory.html" },
    { "source": "/api/bot-stats", "destination": "/api/bot-stats" },
    { "source": "/api/prices", "destination": "/api/prices" },
    { "source": "/api/changelog", "destination": "/api/changelog" },
    { "source": "/api/chat", "destination": "/api/chat" },
    { "source": "/api/gallery", "destination": "/api/gallery" },
    { "source": "/api/auth", "destination": "/api/auth" },
    { "source": "/api/track", "destination": "/api/track" },
    { "source": "/auth/callback", "destination": "/api/auth?action=callback" },
    { "source": "/api2/:path*", "destination": "/api/proxy?api2=1&endpoint=:path*" },
    { "source": "/api/:path*", "destination": "/api/proxy?endpoint=:path*" },
    { "source": "/trade-api/:path*", "destination": "https://kirka.lukeskywalk.com/:path*" },
    { "source": "/kirka-assets/:path*", "destination": "https://kirka.io/:path*" },
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}
