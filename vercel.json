{
  "redirects": [
    { "source": "/((?!ad-frame\\.html).*)", "has": [{ "type": "host", "value": "ads.kirkahub.online" }], "destination": "https://kirkahub.online/$1", "permanent": true },
    { "source": "/aim-trainer", "destination": "/aimtrainer", "permanent": true },
    { "source": "/roulette", "destination": "/giveaway", "permanent": true },
    { "source": "/skin-editor", "destination": "/skineditor", "permanent": true }
  ],
  "rewrites": [
    { "source": "/api/bot-stats", "destination": "/api/bot-stats" },
    { "source": "/api/prices", "destination": "/api/prices" },
    { "source": "/api/changelog", "destination": "/api/changelog" },
    { "source": "/api/chat", "destination": "/api/chat" },
    { "source": "/api2/:path*", "destination": "/api/proxy?api2=1&endpoint=:path*" },
    { "source": "/api/:path*", "destination": "/api/proxy?endpoint=:path*" },
    { "source": "/trade-api/:path*", "destination": "https://kirka.lukeskywalk.com/:path*" },
    { "source": "/kirka-assets/:path*", "destination": "https://kirka.io/:path*" },
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}
